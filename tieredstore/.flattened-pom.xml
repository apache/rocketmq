      <post>commits@rocketmq.apache.org</post>
    </mailingList>
  </mailingLists>
  <scm>
    <connection>scm:git:git@github.com:apache/rocketmq.git/rocketmq-tiered-store</connection>
    <developerConnection>scm:git:git@github.com:apache/rocketmq.git/rocketmq-tiered-store</developerConnection>
    <url>git@github.com:apache/rocketmq.git/rocketmq-tiered-store</url>
  </scm>
